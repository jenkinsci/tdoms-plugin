<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:entry title="IBM i Server" field="server">
        <f:combobox />
    </f:entry>
    <f:entry title="Branch / Task Code" field="branch">
        <f:textbox />
    </f:entry>
    <f:entry title="Deployment CL Command Template" field="command">
        <f:textbox default="STROMSDEP BRANCH('${BRANCH}')" />
    </f:entry>
    <f:entry title="Log Level" field="logLevel">
        <f:select default="3" />
    </f:entry>
</j:jelly>
