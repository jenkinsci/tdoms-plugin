<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:entry title="Branch" field="branch">
        <f:textbox />
    </f:entry>
    <f:entry title="Application" field="application">
        <f:textbox default="*CALC" />
    </f:entry>
    <f:entry title="Task" field="task">
        <f:textbox default="*CALC" />
    </f:entry>
    <f:entry title="Add to Build Queue" field="addToBuildQueue">
        <f:textbox default="*NO" />
    </f:entry>
    <f:entry title="Release Build Queue" field="releaseBuildQueue">
        <f:textbox default="*BATCH" />
    </f:entry>
</j:jelly>